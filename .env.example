PORT=3000
MBG_ADMIN_CODE=231005
MBG_SESSION_SECRET=replace-with-a-long-random-secret
# development: local testing; production/lan: enforce MBG_ALLOWED_NETWORKS; cloud: allow all (recommended for Vercel)
MBG_NETWORK_MODE=cloud
# Comma-separated CIDR ranges (only used when MBG_NETWORK_MODE=lan)
MBG_ALLOWED_NETWORKS=192.168.1.0/24

# Supabase Credentials (Dapatkan di: Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Gunakan service_role key (secret) agar backend Express memiliki izin kelola penuh ke database
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
